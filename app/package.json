{
  "name": "app",
  "version": "1.0.0",
  "private": true,
  "description": "Discord bot + API service",
  "main": "dist/app/src/index.js",
  "types": "dist/app/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app/src/index.d.ts",
      "default": "./dist/app/src/index.js"
    },
    "./api/router": {
      "types": "./dist/app/src/api/router.d.ts",
      "default": "./dist/app/src/api/router.js"
    }
  },
  "scripts": {
    "dev": "nodemon",
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && copyfiles -f src/modules/canvas/font/*.ttf dist/app/src/modules/canvas/font",
    "start": "node dist/app/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && pnpm run typecheck"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.56",
    "chroma-js": "^3.0.0",
    "get-image-colors": "^4.0.1",
    "gif-encoder-2": "^1.0.5",
    "pokersolver": "^2.1.4",
    "@discordjs/rest": "^2.6.0",
    "@fastify/cors": "^11.2.0",
    "@trpc/server": "^11.10.0",
    "discord-api-types": "^0.38.33",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "knex": "^3.1.0",
    "mysql2": "^3.18.1",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "@eslint/js": "^9.39.1",
    "@types/chroma-js": "^2.4.4",
    "@types/get-image-colors": "^4.0.5",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.39.1",
    "copyfiles": "^2.4.1",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.5.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "^8.48.0"
  }
}
