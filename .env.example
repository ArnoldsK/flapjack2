# Copy to .env and fill in values. Used by the app when run from repo root.

# Discord (required for app)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Server
NODE_ENV=development
API_PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=flapjack

# Web (Vite) – optional; defaults to http://localhost:3000
VITE_API_BASE_URL=
