# Copy to .env and fill in values. Used by the app when run from repo root.

# Discord (required for app)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Server
NODE_ENV=development
API_PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=flapjack

# Web (Vite) – required. Local: http://localhost:3000  Prod: https://api.pepsidog.lv
VITE_API_BASE_URL=
VITE_DISCORD_INVITE_URL=

# Shut up dotenv, nobody asked for your v17 spam
DOTENV_CONFIG_QUIET=true

# Hosting
HOSTING_URL=
HOSTING_AUTH_NAME=
HOSTING_AUTH_TOKEN=

# Plate Recogniser
PLATE_RECOGNISER_API_KEY=
