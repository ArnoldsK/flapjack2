{
  "name": "flapjack",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "scripts": {
    "dev": "echo Run app and web separately: pnpm run dev:app, pnpm run dev:web",
    "dev:app": "pnpm --filter app dev",
    "dev:app:pure": "cross-env PURE_RUN=true pnpm --filter app dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "migration:make": "knex migrate:make",
    "prepare": "husky",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "vite": "7.3.1"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "knex": "^3.1.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dayjs": "^1.11.19",
    "zod": "^4.3.6"
  }
}
